# Googleログインを使う場合だけ.env.localへコピーし、自分のWebアプリ設定を入力します。
# 設定なしでも問題を閲覧できます。6項目すべてが揃った場合にFirebase Authへ接続します。
# 実設定値・.env.local・元の設定JSONをコミットしないでください。
# VITE_付きの値はブラウザへ公開されます。秘密鍵・AIの認証情報を入れないでください。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 既定は通信しない画面内プレビュー。開発サーバーでAPI接続を試す場合だけlocal-apiへ変更。
# 本番ビルドではlocal-apiを使えません。
VITE_QUEST_DATA_SOURCE=preview

# Google Maps JavaScript APIのブラウザキー（公開値）。設定しない場合、地図の設定案内を表示します。
# Maps JavaScript APIだけを有効化し、HTTPリファラーをlocalhost/127.0.0.1と公開ドメインに制限してください。
VITE_GOOGLE_MAPS_API_KEY=
# Places API (New) を利用できるブラウザキーの環境でのみ true にする。
VITE_GOOGLE_MAPS_PLACES_PICKER=false

# 自治体管理の住所候補用。承認後にサーバー環境へ設定し、VITE_は付けない（共有検証では Secret Manager から Cloud Run へ注入。D-68）。
# QUEST_GOOGLE_GEOCODING_API_KEY=

# Cの撮影画面で地図表示をデバッグするときだけtrueにする（開発サーバー専用。本番ビルドでは無効）。
# VITE_GOOGLE_MAPS_API_KEYも必要。撮影地の座標がGoogle Mapsへ送られます。
# VITE_CAPTURE_LOCATION_MAP_DEBUG=true

# サーバーの認証確認を使う場合だけ、同じFirebaseプロジェクトIDを入力。
# VITE_は付けず、秘密鍵やサービスアカウントJSONは入れません。
# FIREBASE_PROJECT_ID=

# 開発用の管理API: サーバーだけが読む所属設定の絶対パス。
# VITE_ を付けない。実UIDを記入したファイルはリポジトリ外で管理する。
# QUEST_DEMO_MEMBERSHIPS_FILE=/absolute/path/to/local-memberships.json

# 本人記録APIの開発用一時保存。既定offは認証後503で未接続を示す。
# memoryは既定で空のストア。VITE_を付けない。
# QUEST_DISCOVERIES_MODE=memory
# Cの開発用合成記録を指定の本人だけに1件用意する。設定はローカルに置く。
# QUEST_DEMO_DISCOVERY_OWNER_UID=example-owner

# Dの写真素材API。既定offは503、memoryは明示した開発用一時保存。
# サーバーだけが読む設定。実Storageには接続しない。
# QUEST_ADMIN_ASSETS_MODE=memory

# 合成素材専用の管理写真試験。既定off。fixturesは素材のmemory設定が必要。
# QUEST_ADMIN_PHOTO_TEST_MODE=fixtures

# A04の固定生成候補。既定off。fixturesは素材のmemory設定が必要。
# QUEST_ADMIN_DRAFT_MODE=fixtures

# B/Dの架空データ用報告受付と管理一覧。既定off。再起動で消える。
# QUEST_REPORTS_MODE=memory
