{
  "name": "tourism-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run build && node --env-file-if-exists=.env.local server/dist/server/src/main.js",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "13.2.0",
    "motion": "14.10.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "fsevents": false,
    "@firebase/util": false,
    "protobufjs": false
  }
}
